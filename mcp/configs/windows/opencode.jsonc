{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "@playwright/mcp",
        "--browser",
        "chrome",
        "--caps",
        "vision,devtools",
        "--allow-unrestricted-file-access"
      ],
      "enabled": true,
      "timeout": 20000
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true,
      "timeout": 20000
    },
    "exa": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.exa.ai/mcp"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "duckduckgo": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "duckduckgo-mcp-server"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
